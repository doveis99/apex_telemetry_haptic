msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgid "'{name}' 프리셋을 지울까요? 지금 설정은 그대로 남습니다."
msgstr "Удалить пресет «{name}»? Текущие настройки останутся как есть."

msgid "'{name}' 프리셋이 이미 있습니다. 덮어쓸까요?"
msgstr "Пресет «{name}» уже есть. Перезаписать?"

msgid "2 kHz 출력"
msgstr "Вывод 2 кГц"

msgid "2 kHz 출력: 4 ms마다 2 kHz 샘플을 보냄"
msgstr "Вывод 2 кГц: сэмплы 2 кГц каждые 4 мс"

msgid "AMT·수동"
msgstr "AMT / механика"

msgid "APEX 6 Pro가 아님 (device type 0x{type})"
msgstr "Это не APEX 6 Pro (device type 0x{type})"

msgid "ATS 또는 ETS2 설치 폴더"
msgstr "Папка установки ATS или ETS2"

msgid "ATS 햅틱"
msgstr "ATS Хаптика"

msgid "ATS/ETS2 게임"
msgstr "Игра ATS/ETS2"

msgid "ATS/ETS2 게임: 게임 텔레메트리로 진동을 만듭니다. 게임이 실행 중일 때만 컨트롤러를 씁니다.\n테스트 주행: 게임 없이 옆의 ▾에서 고른 주행을 재생합니다. 효과 확인과 튜닝용입니다.\n실행 중에는 바꿀 수 없습니다."
msgstr "Игра ATS/ETS2: вибрация по телеметрии игры; контроллер занят только пока игра запущена.\nТест-драйв: без игры воспроизводит поездку, выбранную в ▾ рядом, для проверки и настройки эффектов.\nВо время работы переключить нельзя."

msgid "GitHub 저장소 열기: 소스 코드, 릴리스, 문의(Issues)"
msgstr "Открыть репозиторий GitHub: исходный код, релизы, вопросы (Issues)"

msgid "H-시프터의 레인지 셀렉터나 스플리터를 조작할 때 '딸깍'에 이어 변속기가 '철컥' 넘어갑니다(스플리터는 약하게). 자동/순차 변속에서는 울리지 않습니다."
msgstr "«Щелчок» при переключении демультипликатора или делителя на H-шифтере, затем коробка переключается с «клацем» (у делителя тихо). Не срабатывает на автомате и секвентальной коробке."

msgid "Steam 밖에 설치했거나 찾지 못한 경우, bin\\win_x64\\amtrucks.exe 또는 eurotrucks2.exe가 있는 게임 폴더를 지정합니다."
msgstr "Для установок вне Steam или ненайденных: укажите папку игры, в которой есть bin\\win_x64\\amtrucks.exe или eurotrucks2.exe."

msgid "Steam에서 ATS/ETS2 설치를 찾지 못했습니다. 게임 폴더를 직접 선택하세요."
msgstr "Установка ATS/ETS2 в Steam не найдена. Выберите папку игры вручную."

msgid "bin\\win_x64\\amtrucks.exe 또는 eurotrucks2.exe가 있는 게임 폴더를 선택하세요."
msgstr "Выберите папку игры, в которой есть bin\\win_x64\\amtrucks.exe или eurotrucks2.exe."

msgid "{error} · {seconds}초 후 재시도"
msgstr "{error} · повтор через {seconds} с"

msgid "{game}의 plugins 폴더에 RenCloud scs-telemetry.dll(v1.12.1, MIT)을 복사합니다."
msgstr "Копирует RenCloud scs-telemetry.dll (v1.12.1, MIT) в папку plugins игры {game}."

msgid "{names} (호환 미확인)"
msgstr "{names} (совместимость не проверена)"

msgid "{name} ({count}개 주파수)"
msgstr "{name} ({count} частот)"

msgid "{name} (기본값)"
msgstr "{name} (по умолчанию)"

msgid "{name} (직접 측정)"
msgstr "{name} (ваше измерение)"

msgid "{name} {index}/{count} · {freq} Hz ↔ {neighbour} Hz"
msgstr "{name} {index}/{count} · {freq} Гц ↔ {neighbour} Гц"

msgid "{name} 연결됨. Ctrl+C로 종료."
msgstr "{name} подключён. Ctrl+C — выход."

msgid "{name} 플러그인 버전 {revision} (지원: {supported})"
msgstr "плагин {name} версии {revision} (поддерживается: {supported})"

msgid "↻ 다시 듣기"
msgstr "↻ Повторить"

msgid "└ 엔진 박자"
msgstr "└ Такт двигателя"

msgid "■  정지"
msgstr "■  Стоп"

msgid "▶  시작"
msgstr "▶  Старт"

msgid "◀ 첫 번째"
msgstr "◀ Первый"

msgid "✓ '{name}'(으)로 바꿈"
msgstr "✓ Переключено на «{name}»"

msgid "✓ '{name}'에 저장됨"
msgstr "✓ Сохранено в «{name}»"

msgid "✓ 저장됨"
msgstr "✓ Сохранено"

msgid "가속도 최대"
msgstr "Макс. ускор."

msgid "가속도가 순간적으로 크게 튀면(충돌, 큰 충격) 강한 50Hz 펄스를 냅니다. 기준은 '충돌 감지 기준'에서 정합니다."
msgstr "Сильный импульс 50 Гц при скачке ускорения (аварии, сильные удары). Уровень задаёт «Порог удара»."

msgid "감지 기준"
msgstr "Пороги"

msgid "게임 감지 시 자동 시작"
msgstr "Старт при запуске игры"

msgid "게임 값 그대로입니다. 후진 기어는 음수, 중립은 0입니다."
msgstr "Прямо из игры. Задние передачи отрицательные, нейтраль — 0."

msgid "게임 대기 중 (ATS/ETS2 실행 전)"
msgstr "Ожидание игры (ATS/ETS2 не запущена)"

msgid "게임 알림"
msgstr "Уведомления игры"

msgid "게임 종료 시 닫힘"
msgstr "закроется вместе с игрой"

msgid "게임 종료됨, 컨트롤러 해제"
msgstr "Игра закрыта, контроллер освобождён"

msgid "게임 폴더 직접 선택…"
msgstr "Выбрать папку игры…"

msgid "게임 화면 한 프레임 사이의 가속도 변화가 이 값을 넘으면 충돌 펄스를 냅니다. 평소 주행 중 '가속도 최대' 값보다 충분히 높게 두세요."
msgstr "Импульс удара срабатывает, когда ускорение меняется сильнее этого значения от одного кадра игры к следующему. Держите заметно выше «Макс. ускор.» при обычной езде."

msgid "게임에 설치된 텔레메트리 플러그인을 확인하고, 없으면 동봉한 플러그인을 설치합니다."
msgstr "Показывает плагин телеметрии в каждой игре и при необходимости устанавливает встроенный."

msgid "게임에서 받고 있는 값"
msgstr "что сейчас передаёт игра"

msgid "게임이 실행 중이면 다음 실행부터 적용됩니다."
msgstr "Если игра запущена, изменения вступят в силу при следующем запуске."

msgid "게임이 실행 중입니다. 게임을 끝낸 뒤 업데이트하세요."
msgstr "Игра запущена. Обновитесь после выхода из неё."

msgid "고속도로 4분"
msgstr "Трасса 4 мин"

msgid "그립"
msgstr "Рукоять"

msgid "그만"
msgstr "Закончить"

msgid "그만두는 중…"
msgstr "Остановка…"

msgid "금속"
msgstr "Металл"

msgid "기록 {date}"
msgstr "Журнал {date}"

msgid "기록 폴더 ↗"
msgstr "Папка журналов ↗"

msgid "기본 60초"
msgstr "Стандарт 60 с"

msgid "기본값"
msgstr "По умолчанию"

msgid "기어"
msgstr "Передача"

msgid "기어가 바뀔 때 '철컥'. 주행 진동이 잠깐 비었다가 단단하게 맞물리는 느낌입니다. 자동 변속기도 동작합니다. '변속기'를 토크컨버터로 두면 '철컥' 대신 부드럽게 '쿵' 밀어 줍니다."
msgstr "«Клац» при каждом переключении: ходовая вибрация на миг пропадает, затем передача плотно входит. Работает и с автоматом. Если в «Коробка передач» выбран Гидроавтомат, вместо «клаца» будет мягкий толчок."

msgid "기차"
msgstr "Поезд"

msgid "나무"
msgstr "Дерево"

msgid "내려받는 중 {percent}"
msgstr "Загрузка {percent}"

msgid "내려받아 설치하고 프로그램을 다시 시작할까요?"
msgstr "Скачать, установить и перезапустить программу?"

msgid "노면"
msgstr "Дорога"

msgid "노면 재질(얼음 < 아스팔트 < 콘크리트 < 눈 < 나무 < 금속 < 잔디 < 흙 < 자갈)과 속도로 세기와 질감이 정해집니다. 아스팔트는 고르게 '쉬익', 콘크리트는 이음매마다 '툭·툭', 나무는 판자가 '두두두', 금속은 '웅' 하고 울리고, 잔디·흙은 천천히 출렁이며, 자갈·흙·눈에는 돌이 튀는 '탁탁'이 섞입니다. 험한 길에서는 캡이 덜컹거립니다. 빠를수록 촘촘해지고, 왼쪽과 오른쪽 바퀴가 따로 갑니다."
msgstr "Сила и характер зависят от покрытия (лёд < асфальт < бетон < снег < дерево < металл < трава < грунт < гравий) и скорости. Асфальт ровно шуршит, бетон стучит на каждом стыке, деревянный настил барабанит, металл гудит, трава и грунт медленно колышутся, а гравий, грунт и снег добавляют щелчки камешков. На разбитой дороге дребезжит кабина. Чем быстрее, тем чаще, а левые и правые колёса звучат отдельно."

msgid "노면은 재질을 골라 80 km/h로 그 위만 달려 보거나, 모든 재질을 차례로 달려 볼 수 있습니다."
msgstr "Для дороги можно выбрать покрытие и проехать только по нему на 80 км/ч или по всем покрытиям по очереди."

msgid "눈"
msgstr "Снег"

msgid "다시 보정"
msgstr "Откалибровать заново"

msgid "다운로드한 파일의 해시가 릴리스와 다릅니다"
msgstr "Хеш загруженного файла не совпадает с релизом"

msgid "닫기"
msgstr "Закрыть"

msgid "달리는 동안 계속 나는 진동"
msgstr "постоянная вибрация в движении"

msgid "동봉한 RenCloud scs-telemetry.dll을 이 게임의 plugins 폴더에 복사합니다. 다른 플러그인은 건드리지 않습니다."
msgstr "Копирует встроенный RenCloud scs-telemetry.dll в папку plugins этой игры. Другие плагины не затрагиваются."

msgid "두 번째 ▶"
msgstr "Второй ▶"

msgid "둘 다"
msgstr "Оба"

msgid "디버그 기록"
msgstr "Журнал отладки"

msgid "디버그 기록 재생…"
msgstr "Воспроизвести журнал отладки…"

msgid "디버그 기록 종료"
msgstr "Журнал отладки остановлен"

msgid "디버그 기록: {name}"
msgstr "Журнал отладки: {name}"

msgid "디버그 기록을 열 수 없음 ({error})"
msgstr "Не удалось открыть журнал отладки ({error})"

msgid "디버그 기록이 쌓이는 폴더를 엽니다."
msgstr "Открывает папку с журналами отладки."

msgid "레인지 셀렉터"
msgstr "Демультипликатор"

msgid "레인지/스플리터"
msgstr "Демульт./делитель"

msgid "리타더"
msgstr "Ретардер"

msgid "리타더 단계에 비례하는 웅웅거림으로, 빠를수록 음이 높아집니다(40~65Hz). 엔진 브레이크는 엔진 점화 박자에 맞춰 '다다닥' 노크하고, 엑셀을 밟으면 멈춥니다."
msgstr "Гул пропорционально ступени ретардера, тем выше, чем больше скорость (40–65 Гц). Моторный тормоз стучит в такт зажиганию двигателя и стихает при нажатии газа."

msgid "릴리스 zip에 {exe}이 없습니다"
msgstr "В zip-архиве релиза нет {exe}"

msgid "릴리스 페이지를 열까요?"
msgstr "Открыть страницу релиза?"

msgid "모든 세기와 기준, 진동 위치를 기본값으로 되돌리고 모든 효과를 켭니다. 저장은 따로 눌러야 합니다."
msgstr "Сбрасывает все уровни, пороги и выходы и включает все эффекты. Чтобы сохранить, нажмите «Сохранить»."

msgid "모터 보정"
msgstr "Калибровка моторов"

msgid "모터 보정…"
msgstr "Калибровка моторов…"

msgid "모터가 주파수마다 다르게 울리는 정도를 손으로 느끼며 맞춥니다. 결과는 모든 효과에 주파수별로 적용됩니다. 출력을 정지한 상태에서 씁니다."
msgstr "Подстройка на ощупь: насколько по-разному моторы отзываются на каждой частоте. Результат применяется ко всем эффектам по частотам. Используйте при остановленном выводе."

msgid "모터는 그립 약 65Hz, 트리거 약 100Hz에서 가장 세게 울려서, 같은 세기로 보내도 주파수마다 다르게 느껴집니다. 이웃한 두 주파수가 차례로 울리면 어느 쪽이 더 셌는지 고르세요. 조금이라도 센 쪽이 있으면 그쪽을, 정말 구분이 안 되면 아무 쪽이나 고르면 됩니다. 구분이 안 된다는 건 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 답에 따라 세기를 좁혀 가며 같게 느껴지는 지점을 찾고, 모든 효과가 주파수별로 그만큼 보정됩니다. 모터 하나에 3~5분 걸립니다."
msgstr "Моторы сильнее всего отзываются около 65 Гц (рукояти) и 100 Гц (курки), поэтому один и тот же сигнал на разных частотах ощущается по-разному. Две соседние частоты звучат по очереди: выберите ту, что ощущалась сильнее. Если одна была хоть немного сильнее, выберите её; если разницы правда не чувствуется, выберите любую. Значит, они уже почти равны, и на результат это не повлияет. По ответам подбирается сила, при которой обе ощущаются одинаково, и каждый эффект на каждой частоте корректируется на столько же. На один мотор уходит 3–5 минут."

msgid "바뀐 설정을 저장할까요?"
msgstr "Сохранить изменённые настройки?"

msgid "방향지시등"
msgstr "Поворотники"

msgid "방향지시등 우"
msgstr "Правый поворотник"

msgid "방향지시등 좌"
msgstr "Левый поворотник"

msgid "방향지시등이 점멸할 때마다 켜진 쪽 그립에 '틱'."
msgstr "«Тик» в рукояти на стороне поворотника при каждом мигании."

msgid "배송 완료"
msgstr "Доставка завершена"

msgid "번들 플러그인이 없습니다: {path}"
msgstr "Встроенный плагин не найден: {path}"

msgid "벌금"
msgstr "Штраф"

msgid "변경됨 · 저장 안 됨"
msgstr "Изменено · не сохранено"

msgid "변속"
msgstr "Переключение"

msgid "변속 {gear}단"
msgstr "Передача {gear}"

msgid "변속, 충돌, 페달, 트레일러, 파킹 브레이크, 방향지시등, 시동, 게임 알림과 컨트롤러 연결 문제가 시간과 함께 기록됩니다. 최근 50개까지 보입니다."
msgstr "Переключения, удары, педали, прицеп, стояночный тормоз, поворотники, запуск двигателя, уведомления игры и проблемы связи с контроллером с указанием времени. Показываются последние 50."

msgid "변속과 충돌을 포함한 모든 이벤트 효과가 울리는 순간, 같은 위치의 주행 진동을 잠깐 줄여 이벤트가 묻히지 않게 하는 정도입니다. 0%면 줄이지 않습니다."
msgstr "Действует на все эффекты событий, включая переключение передач и удары: насколько ходовая вибрация на том же моторе ненадолго стихает во время события, чтобы его не заглушить. 0% — без изменений."

msgid "변속기"
msgstr "Коробка передач"

msgid "변속할 때의 느낌입니다. AMT·수동은 레버가 빠지고 다음 기어가 '철컥' 들어갑니다(이튼 풀러, DT12 같은 변속기). 토크컨버터는 동력이 끊기지 않고 다음 기어가 물리며 부드럽게 '쿵' 밀어 줍니다(앨리슨). 엑셀을 깊이 밟을수록 단단하고, 발을 떼고 변속하면 거의 없습니다. 텔레메트리에는 변속기 종류가 없습니다."
msgstr "Каким ощущается переключение. AMT / механика: рычаг выходит из передачи, и следующая входит с «клацем» (коробки вроде Eaton Fuller или DT12). Гидроавтомат (с гидротрансформатором): тяга не прерывается, следующая передача включается мягким толчком (Allison). Чем глубже нажат газ, тем твёрже; без газа почти незаметно. Телеметрия не сообщает тип коробки."

msgid "보정 지우기"
msgstr "Сбросить калибровку"

msgid "보정을 저장했습니다: {channels}. 다음 시작부터 적용됩니다."
msgstr "Калибровка сохранена: {channels}. Применится со следующего запуска."

msgid "보정하지 못했습니다: {error}"
msgstr "Не удалось откалибровать: {error}"

msgid "복사하지 못했습니다: {error}"
msgstr "Не удалось скопировать: {error}"

msgid "브레이크"
msgstr "Тормоз"

msgid "브레이크 스퀼"
msgstr "Скрип тормозов"

msgid "브레이크 페달을 떼면 브레이크 챔버의 공기가 빠지며 '툭' 하고 짧게 '푸쉬익'. 세게 밟았을수록 크고, 잠깐 톡 친 정도로는 나지 않습니다. 브레이크를 뗄 때마다 나므로 '주행 진동 양보'로 주행 진동을 줄이지 않습니다."
msgstr "Когда вы отпускаете педаль тормоза, тормозные камеры стравливают воздух: «тук» и короткое «пшш». Чем сильнее тормозили, тем громче; лёгкое касание не вызывает. Звучит при каждом отпускании, поэтому «Уступать событиям» не приглушает ради него ходовые эффекты."

msgid "비교 {trial}번째"
msgstr "Сравнение {trial}"

msgid "삭제"
msgstr "Удалить"

msgid "산길 3분"
msgstr "Горы 3 мин"

msgid "새 버전 {new}이 있습니다 (현재 {current})."
msgstr "Доступна версия {new} (текущая: {current})."

msgid "새 버전의 릴리스 노트를 보고, 내려받아 설치한 뒤 다시 시작합니다. 설정은 그대로입니다."
msgstr "Показывает примечания к выпуску, затем скачивает, устанавливает и перезапускает. Настройки сохраняются."

msgid "새 프리셋"
msgstr "Новый пресет"

msgid "서스펜션이 이 속도보다 갑자기 빨리 움직이면 요철 펄스를 냅니다. 낮추면 작은 요철에도, 높이면 큰 충격에만 반응합니다. 트럭이 평소에 많이 흔들리면 기준이 저절로 그만큼 올라갑니다."
msgstr "Импульс неровности срабатывает, когда подвеска внезапно движется быстрее этого значения. Ниже — чувствуются мелкие неровности, выше — только сильные удары. Если грузовик сильно трясёт, порог сам поднимается выше этого значения."

msgid "설치"
msgstr "Установить"

msgid "설치 중…"
msgstr "Установка…"

msgid "설치했습니다."
msgstr "Установлено."

msgid "속도"
msgstr "Скорость"

msgid "순간적으로 한 번 나는 진동"
msgstr "короткий одиночный импульс"

msgid "스플리터"
msgstr "Делитель"

msgid "슬라이더, 켜기/끄기, 진동 위치를 %APPDATA%\\ATSHaptics\\config.json에 저장합니다. 프리셋을 쓰는 중이면 그 프리셋에도 저장합니다. 저장하지 않은 변경이 있으면 버튼이 파랗게 바뀝니다."
msgstr "Сохраняет ползунки, переключатели и выходы в %APPDATA%\\ATSHaptics\\config.json. Если выбран пресет, то и в него. Кнопка синяя, пока есть несохранённые изменения."

msgid "시내 2분 30초"
msgstr "Город 2,5 мин"

msgid "시동"
msgstr "Запуск двигателя"

msgid "시동 끔"
msgstr "Двигатель заглушен"

msgid "시동 켜기/끄기"
msgstr "Пуск/остановка"

msgid "시동을 켤 때 1초쯤 크랭킹하다가 '부웅' 하고 걸리고, 끌 때 잠깐 더 돌다가 '투둑투둑' 잦아듭니다."
msgstr "При запуске около секунды прокрутки стартером, затем двигатель схватывает с «врум»; при глушении он ещё мгновение работает и затухает с перебоями."

msgid "시작"
msgstr "Начать"

msgid "시작 중"
msgstr "запуск"

msgid "아스팔트"
msgstr "Асфальт"

msgid "아스팔트 → 자갈"
msgstr "Асфальт → гравий"

msgid "약 14km/h 이하에서 브레이크를 밟으며 서서히 멈출 때 '끼익, 끽' 하고 끊어지며 우는 가는 진동입니다."
msgstr "Тонкий визг отдельными всплесками при плавном торможении до остановки на скорости ниже ~14 км/ч."

msgid "어느 쪽이 더 셌나요?"
msgstr "Какой был сильнее?"

msgid "얼음"
msgstr "Лёд"

msgid "업데이트"
msgstr "Обновление"

msgid "업데이트 {version}"
msgstr "Обновить до {version}"

msgid "업데이트하지 못했습니다: {error}"
msgstr "Не удалось обновить: {error}"

msgid "없음"
msgstr "Нет"

msgid "에어 브레이크"
msgstr "Пневмотормоз"

msgid "엑셀"
msgstr "Газ"

msgid "엑셀 {throttle} / 브레이크 {brake}"
msgstr "газ {throttle} / тормоз {brake}"

msgid "엑셀 트리거 진동을 엔진 점화 박자에 맞춰 출렁이게 하는 정도입니다. 엔진 진동과 같은 폭발을 따라가서 공회전의 울렁임과 폭발마다 다른 세기도 느껴집니다. 0%면 일정하게 울립니다. 브레이크 쪽에는 영향이 없습니다."
msgstr "Насколько курок газа пульсирует в такт вспышкам двигателя. Он следует тем же вспышкам, что и вибрация двигателя, поэтому чувствуются и неровный холостой ход, и сила каждой вспышки. 0% — ровная вибрация. На тормоз не влияет."

msgid "엑셀/브레이크"
msgstr "Газ/тормоз"

msgid "엑셀/브레이크 입력(0~1)입니다. 크루즈 컨트롤처럼 게임이 대신 밟는 값은 포함하지 않습니다."
msgstr "Ваш ввод газа/тормоза (0–1). То, что игра добавляет сама (например, круиз-контроль), не учитывается."

msgid "엑셀을 밟는데 구동 바퀴가 트럭보다 빨리 헛돌면(얼음, 눈, 진흙, 급출발) 양쪽 그립에 거칠게 긁히는 진동을 냅니다. 브레이크로 바퀴가 잠기는 휠락은 '엑셀/브레이크'에서 냅니다."
msgstr "Грубое шуршание в обеих рукоятях, когда ведущие колёса под газом крутятся быстрее, чем едет грузовик (лёд, снег, грязь, резкий старт). Блокировка колёс при торможении — в «Газ/тормоз»."

msgid "엑셀이나 브레이크를 끝까지(97% 이상) 밟는 순간 짧은 '툭'."
msgstr "Короткий «тук», когда газ или тормоз нажаты до упора (97% и больше)."

msgid "엔진"
msgstr "Двигатель"

msgid "엔진 기통 수"
msgstr "Число цилиндров"

msgid "엔진 점화 주파수(rpm ÷ 60 × 기통 수 ÷ 2)에 2배음을 더한 진동입니다. 엑셀을 밟을수록, rpm이 높을수록 세집니다. 공회전에서는 실린더마다 폭발이 고르지 않아 울렁이고, 부하가 크면 거칠어집니다. 시동이 꺼져 있으면 없습니다. 차가 멈춰 서면 공회전 진동이 최대 3배로 커집니다."
msgstr "Частота вспышек двигателя (об/мин ÷ 60 × цилиндры ÷ 2) плюс вторая гармоника. Сильнее при большем газе и оборотах. На холостом ходу цилиндры работают неровно и мотор «плавает»; под нагрузкой звучит жёстче. При заглушённом двигателе отсутствует. Когда грузовик стоит, вибрация холостого хода усиливается до 3 раз."

msgid "엔진 진동 주파수 계산에 씁니다. ATS 순정 트럭은 대부분 직렬 6기통이고, ETS2의 Scania V8 같은 트럭은 8로 두세요. 텔레메트리에는 기통 수가 없습니다."
msgstr "Нужно для расчёта частоты вибрации двигателя. У большинства стандартных грузовиков ATS рядная шестёрка; для машин вроде Scania V8 в ETS2 укажите 8. Телеметрия этого не сообщает."

msgid "엔진(rpm·부하), 노면(재질·속도), 엑셀/브레이크(페달)가 그대로 유지되면 그 진동을 수십 초에 걸쳐 이 비율만큼 줄입니다. 변함없는 진동은 손이 곧 느끼지 못하고 피로만 쌓이기 때문입니다. 가속·감속, 변속, 노면이 바뀌거나 페달을 움직이면 바로 돌아오고, 크루즈 중 작은 속도 변화나 손가락 떨림은 무시합니다."
msgstr "Пока то, что их задаёт, не меняется (двигатель: обороты и нагрузка; дорога: покрытие и скорость; газ/тормоз: педаль), эти вибрации за несколько десятков секунд снижаются на эту долю: неизменную вибрацию рука скоро перестаёт замечать, остаётся только усталость. Сразу возвращаются при разгоне или замедлении, переключении, смене покрытия или движении педали; мелкие колебания круиз-контроля и лежащий на курке палец не в счёт."

msgid "오류: {error}"
msgstr "Ошибка: {error}"

msgid "오른쪽 그립"
msgstr "Правая рукоять"

msgid "왼쪽 그립"
msgstr "Левая рукоять"

msgid "요철"
msgstr "Неровности"

msgid "요철 감지 기준"
msgstr "Порог неровностей"

msgid "이 모터로 실제로 나가는 세기입니다. 진동이 약하거나 없을 때 어느 단계에서 줄어드는지 확인하세요."
msgstr "Что на самом деле подаётся на этот мотор. Помогает понять, где теряется вибрация, если она слабая или пропала."

msgid "이 프리셋으로 바꿉니다. 오른쪽 클릭: 이름 바꾸기, 삭제"
msgstr "Переключает на этот пресет. Правый клик: переименовать, удалить"

msgid "이 효과 켜기/끄기. 꺼도 세기와 진동 위치는 남아서 다시 켜면 그대로 돌아옵니다."
msgstr "Включает или выключает этот эффект. Уровень и выход сохраняются и возвращаются как были."

msgid "이 효과만 몇 초 동안 울려 봅니다. 지금 세기, 진동 위치, 모터 보정 그대로이고, 꺼 둔 효과도 울립니다. 요철, 차선 요철, 방향지시등은 왼쪽 다음 오른쪽 순서입니다. 출력 중에는 그동안 주행 진동 대신 울립니다."
msgstr "Несколько секунд играет только этот эффект, с текущим уровнем, выходом и калибровкой моторов, даже если он выключен. Неровности, Шумовые полосы и Поворотники звучат сначала слева, потом справа. Если вывод запущен, на это время он заменяет вибрацию езды."

msgid "이 효과의 진동이 갈 곳: 그립(파랑), 트리거(주황), 둘 다(보라). 꺼진 효과에서 위치를 누르면 그 위치로 다시 켜집니다."
msgstr "Куда идёт этот эффект: рукоять (синий), курок (оранжевый) или оба (фиолетовый). Выбор места у выключенного эффекта снова включает его там."

msgid "이름 바꾸기"
msgstr "Переименовать"

msgid "이름 바꾸기…"
msgstr "Переименовать…"

msgid "이벤트"
msgstr "События"

msgid "이벤트 효과"
msgstr "Эффекты событий"

msgid "일시정지/메뉴"
msgstr "Пауза / меню"

msgid "입력"
msgstr "Источник"

msgid "자갈"
msgstr "Гравий"

msgid "잔디"
msgstr "Трава"

msgid "재생할 디버그 기록"
msgstr "Журнал отладки для воспроизведения"

msgid "재설치"
msgstr "Переустановить"

msgid "저장"
msgstr "Сохранить"

msgid "저장된 보정을 지우고 기본값으로 되돌릴까요?"
msgstr "Сбросить сохранённую калибровку и вернуть калибровку по умолчанию?"

msgid "저장된 보정을 지워 기본값으로 되돌립니다."
msgstr "Сбрасывает сохранённую калибровку и возвращает калибровку по умолчанию."

msgid "저장하지 않은 변경이 있습니다. 바꾸기 전에 저장할까요?"
msgstr "Есть несохранённые изменения. Сохранить их перед переключением?"

msgid "저장한 보정이 없습니다. 모터 하나를 끝까지 맞추면 저장됩니다."
msgstr "Калибровка не сохранена. Мотор сохраняется, когда подобраны все его частоты."

msgid "전부 차례로 (얼음 → 자갈, 각 {seconds}초)"
msgstr "Все по очереди (лёд → гравий, по {seconds} с)"

msgid "전체"
msgstr "Общий"

msgid "정속 시 줄임"
msgstr "Затухание в круизе"

msgid "정지 중…"
msgstr "Остановка…"

msgid "정지됨"
msgstr "Остановлено"

msgid "조금이라도 센 쪽이 있으면 그쪽을, 구분이 안 되면 아무 쪽이나 고르세요. 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 재생 중에 눌러도 바로 반영됩니다."
msgstr "Если один был хоть немного сильнее, выберите его; если разницы не чувствуется, выберите любой. Значит, они уже почти равны, и на результат это не повлияет. Ответы принимаются и во время звучания."

msgid "종료: 모터 해제 완료."
msgstr "Остановлено: моторы освобождены."

msgid "좌우 그립 모터에만 적용되는 최종 세기입니다."
msgstr "Итоговая сила только для моторов левой и правой рукояти."

msgid "주유"
msgstr "Заправка"

msgid "주행 중 ({source})"
msgstr "В пути ({source})"

msgid "주행 진동 양보"
msgstr "Уступать событиям"

msgid "주행 효과"
msgstr "Ходовые эффекты"

msgid "중앙선이나 갓길의 차선 요철(럼블 스트립)을 밟은 쪽 그립에 '드르르륵'. 게임이 알려 주는 노면 재질로 감지하고, 빠를수록 촘촘해집니다."
msgstr "Дробь «брррр» в рукояти той стороны, что наехала на шумовую полосу у осевой или обочины. Определяется по покрытию, которое сообщает игра; чем быстрее, тем чаще."

msgid "지금 밟고 있는 페달을 따라가는 트리거 진동입니다. 엑셀은 밟은 만큼 세지고, 브레이크는 바퀴가 잠기면(휠락) 끊기는 펄스를 냅니다."
msgstr "Вибрация курка по нажатой педали: газ усиливается по мере нажатия, тормоз пульсирует при блокировке колёс."

msgid "지금 보정: {channels}"
msgstr "Текущая калибровка: {channels}"

msgid "지금 설정(저장하지 않은 변경 포함)을 새 이름으로 보관하고 그 프리셋으로 바꿉니다."
msgstr "Сохраняет текущие настройки (вместе с несохранёнными изменениями) под новым именем и переключает на этот пресет."

msgid "지난 세션: 지연 프레임 {late} / 최대 {max} ms"
msgstr "Прошлая сессия: опоздавших кадров {late} / макс. {max} мс"

msgid "직전 세션에서 8ms 출력 주기를 놓친 횟수와 가장 늦었던 시간입니다. 0에 가까우면 정상입니다."
msgstr "Сколько раз прошлая сессия пропустила 8-мс цикл вывода и наибольшая задержка. Около 0 — норма."

msgid "진동 위치"
msgstr "Куда"

msgid "진동 출력을 시작하거나 멈춥니다. 정지하면 모터를 끄고 컨트롤러를 놓습니다."
msgstr "Запускает или останавливает вывод вибрации. При остановке моторы выключаются, контроллер освобождается."

msgid "진동은 게임의 텔레메트리 플러그인(RenCloud 계열 rev 12) 데이터를 사용합니다."
msgstr "Вибрация строится по данным плагина телеметрии игры (семейство RenCloud, rev 12)."

msgid "차선 요철"
msgstr "Шумовые полосы"

msgid "창이 정지 상태일 때 게임이 실행되면 자동으로 시작합니다. 게임 도중 직접 정지하면 그 게임이 끝날 때까지는 다시 켜지지 않습니다. 바꾸면 바로 저장됩니다."
msgstr "Запускается автоматически, когда игра стартует при остановленном окне. Если остановить во время игры, не включится до её завершения. Сохраняется сразу."

msgid "첫 번째 → 두 번째 재생 중…"
msgstr "Звучит первый → второй…"

msgid "첫 번째 바퀴 아래 노면 재질의 게임 내부 이름입니다(예: road, gravel, grass)."
msgstr "Внутреннее имя покрытия под первым колесом (например, road, gravel, grass)."

msgid "최근 0.1초 동안 수평 가속도 최대값입니다. 충돌 감지 기준을 정할 때 참고하세요."
msgstr "Максимальное горизонтальное ускорение за последние 0,1 с. Помогает выбрать порог удара."

msgid "출력 세기"
msgstr "Уровень вывода"

msgid "출력 제어"
msgstr "Управление выводом"

msgid "출력을 정지한 다음 보정하세요."
msgstr "Остановите вывод перед калибровкой."

msgid "출력이 게임을 기다리는 중이라 지금은 컨트롤러를 쓰지 않습니다. 정지한 다음 테스트하세요."
msgstr "Вывод ждёт игру и сейчас не использует контроллер. Остановите его, затем проверяйте."

msgid "충돌"
msgstr "Удар"

msgid "충돌 {accel} m/s²"
msgstr "Удар {accel} м/с²"

msgid "충돌 감지 기준"
msgstr "Порог удара"

msgid "컨트롤러 미사용"
msgstr "Контроллер не занят"

msgid "컨트롤러 상태 · 텔레메트리 상태\n점 색: 초록 출력 중, 노랑 컨트롤러 대기, 빨강 오류, 회색 정지"
msgstr "Состояние контроллера · состояние телеметрии\nТочка: зелёная — вывод идёт, жёлтая — ждёт контроллер, красная — ошибка, серая — остановлено"

msgid "컨트롤러 안 보임: Steam이 실행한 프로세스라 Steam Input이 패드를 숨김 (창을 따로 실행하거나 게임의 Steam Input 끄기)"
msgstr "Контроллер скрыт: процесс запущен Steam, и Steam Input прячет геймпад (откройте окно отдельно или отключите Steam Input для игры)"

msgid "컨트롤러 없음"
msgstr "Нет контроллера"

msgid "컨트롤러 없음 (유선/2.4G 동글 연결, 전원 확인)"
msgstr "Контроллер не найден (проверьте кабель или донгл 2,4 ГГц и питание)"

msgid "컨트롤러 연결 끊김 ({error})"
msgstr "Контроллер отключён ({error})"

msgid "컨트롤러 응답 없음 (절전 중이면 버튼을 눌러 깨우세요)"
msgstr "Контроллер не отвечает (нажмите кнопку, если он в спящем режиме)"

msgid "컨트롤러 해제. {stats}"
msgstr "Контроллер освобождён. {stats}"

msgid "컨트롤러로 나가는 최종 세기입니다. 효과별 세기를 모두 섞은 다음 그립과 트리거 모두에 적용됩니다. 100%를 넘기면 약한 효과는 세지고 이미 센 효과는 거의 그대로입니다."
msgstr "Итоговая сила, отправляемая на контроллер: применяется к рукоятям и куркам после смешивания всех эффектов. Выше 100% слабые эффекты усиливаются, а сильные почти не меняются."

msgid "컨트롤러를 열 수 없음 ({error})"
msgstr "Не удаётся открыть контроллер ({error})"

msgid "컨트롤러를 평소처럼 잡으세요. 패드 버튼으로 답할 수 있습니다: 십자키 ← 또는 LB 첫 번째, → 또는 RB 두 번째, X 다시 듣기, B 그만. 키보드는 ← → (또는 1 2) R Esc입니다. 재생 중에 눌러도 바로 반영됩니다."
msgstr "Держите контроллер как обычно. Отвечать можно кнопками геймпада: крестовина ← или LB — первый, → или RB — второй, X повторить, B закончить. С клавиатуры: ← → (или 1 2) R Esc. Ответы принимаются и во время звучания."

msgid "켜 두면 시작할 때마다 컨트롤러로 보낸 8ms 블록을 하나씩 CSV로 남깁니다(시각, 주기 간격, 트리거 경로, 채널별 세기, 속도·노면·이벤트). 진동이 이상하면 그 시각을 기억해 두고 이 파일을 보세요. 1시간에 약 30MB, 최근 10개만 남깁니다. 주행 중에도 켜고 끄는 즉시 적용되고 바로 저장됩니다."
msgstr "Если включено, при каждом запуске каждый 8-мс блок, отправленный на геймпад, пишется в CSV (время, интервал, маршрут курков, сила по каналам, скорость, покрытие, события). Если вибрация кажется странной, запомните время и найдите его там. Около 30 МБ в час; хранятся 10 последних. Действует сразу, даже во время поездки, сохраняется сразу."

msgid "켜면 1 kHz 대신 2 kHz 샘플을 4ms마다 컨트롤러로 보냅니다. 진동 세기는 그대로 두고, 1 kHz로 보낼 때 패드가 같이 내던 500~1000 Hz 잔음을 걸러 내며, 딸깍(틱)은 더 날카롭게 냅니다. 무선에서 끊김이 잦아지면 끄세요. 주행이나 테스트 중에도 바로 바뀌고 바로 저장됩니다."
msgstr "Если включено, геймпад получает сэмплы 2 кГц каждые 4 мс вместо 1 кГц. Сила вибрации не меняется, гул 500–1000 Гц, который геймпад издавал при сэмплах 1 кГц, отфильтровывается, а щелчки (тики) становятся резче. Выключите, если по беспроводной связи участятся пропуски. Действует сразу, даже во время поездки или теста, сохраняется сразу."

msgid "콘크리트"
msgstr "Бетон"

msgid "키보드 {keys}"
msgstr "Клавиатура {keys}"

msgid "테스트 주행"
msgstr "Тест-драйв"

msgid "테스트 주행이 재생할 주행입니다. 기본 60초는 모든 효과를 한 번씩, 고속도로·시내·산길은 효과가 겹치는 실제 주행 몇 분입니다. 디버그 기록 재생은 기록해 둔 주행을 지금 설정으로 다시 느껴 봅니다. 실행 중에는 바꿀 수 없습니다."
msgstr "Что воспроизводит тест-драйв. Стандартный на 60 с проигрывает каждый эффект по разу; трасса, город и горы — несколько минут настоящей езды, где эффекты накладываются. «Воспроизвести журнал отладки» снова проигрывает записанную поездку с текущими настройками. Во время работы изменить нельзя."

msgid "텔레메트리"
msgstr "Телеметрия"

msgid "텔레메트리 대기 중 (게임 로딩 중이거나 플러그인 없음)"
msgstr "Ожидание телеметрии (игра загружается или нет плагина)"

msgid "텔레메트리 멈춤 (최소화/로딩)"
msgstr "Телеметрия остановилась (свёрнуто или загрузка)"

msgid "텔레메트리 없음: {problem} → '텔레메트리 플러그인'에서 설치"
msgstr "Нет телеметрии: {problem} → установите в «Плагин телеметрии»"

msgid "텔레메트리 플러그인"
msgstr "Плагин телеметрии"

msgid "텔레메트리 플러그인 없음"
msgstr "Нет плагина телеметрии"

msgid "토크컨버터"
msgstr "Гидроавтомат"

msgid "톨게이트"
msgstr "Платный пункт"

msgid "톨게이트, 벌금, 주유, 배송 완료, 페리, 기차 이벤트 때 '톡톡' 두 번."
msgstr "Двойной «тук-тук» на платных пунктах, штрафах, заправке, завершённой доставке, паромах и поездах."

msgid "트레일러 분리"
msgstr "Прицеп отцеплен"

msgid "트레일러 연결"
msgstr "Прицеп сцеплен"

msgid "트레일러를 연결할 때 커플러가 0.6초쯤 '덜커덕덜컥' 맞물리고, 분리할 때 '쿵'에 이어 에어 빠지는 느낌."
msgstr "При сцепке седло дребезжит около 0,6 с; при расцепке — удар и затем шипение воздуха."

msgid "트리거"
msgstr "Курок"

msgid "트리거 모터에만 적용되는 최종 세기입니다. 0%면 트리거 진동이 완전히 꺼집니다. 손가락이 부담스러우면 여기서 낮추세요. 효과별 비율은 그대로 유지됩니다."
msgstr "Итоговая сила только для моторов курков; 0% полностью отключает их вибрацию. Уменьшите здесь, если устают пальцы: соотношение эффектов сохранится."

msgid "트리거 채널이 지금 따라가는 페달입니다."
msgstr "Педаль, за которой сейчас следует канал курков."

msgid "파킹 브레이크"
msgstr "Стояночный тормоз"

msgid "파킹 브레이크 체결"
msgstr "Стояночный тормоз включён"

msgid "파킹 브레이크 해제"
msgstr "Стояночный тормоз выключен"

msgid "파킹 브레이크를 체결하면 '철컥'에 이어 1초 가까이 에어가 빠지는 '쉬이익', 해제하면 '턱'에 이어 짧은 '푸쉭'."
msgstr "При включении стояночного тормоза — «клац» и почти секунду выходящего воздуха; при выключении — «тук» и короткий «пш»."

msgid "패드 {buttons}"
msgstr "Геймпад {buttons}"

msgid "페달"
msgstr "Педали"

msgid "페달 바닥"
msgstr "Педаль в пол"

msgid "페리"
msgstr "Паром"

msgid "포트홀, 연석, 이음매처럼 서스펜션이 갑자기 움직이면 그 바퀴 쪽 그립에 충격을 냅니다. 작은 이음매는 짧고 높은 '톡', 큰 포트홀은 낮고 묵직한 '쿵'이고, 큰 충격 뒤에는 캡이 잠깐 덜컹거립니다. 민감도는 '요철 감지 기준'에서 정합니다. 흙길처럼 캐빈이 출렁이면 그 흔들림을 따라 낮은 '웅'이 이어지고, 캐빈이 기우는 쪽 그립이 더 셉니다."
msgstr "Удар в ручку со стороны колеса, когда подвеска резко срабатывает (ямы, бордюры, стыки): маленький стык — короткий высокий стук, большая яма — низкий тяжёлый удар, а после сильного удара кабина ненадолго дребезжит. Чувствительность задаётся в «Порог неровностей». Когда кабину качает, как на грунтовке, за её раскачкой следует низкий гул, сильнее с той стороны, куда она кренится."

msgid "폴더에 쓸 권한이 없습니다. 프로그램을 관리자 권한으로 실행하거나 아래 파일을 직접 복사하세요."
msgstr "Нет прав на запись в папку. Запустите программу от имени администратора или скопируйте файл ниже вручную."

msgid "프리셋"
msgstr "Пресеты"

msgid "프리셋 이름"
msgstr "Имя пресета"

msgid "프리셋 전환"
msgstr "Смена пресета"

msgid "프리셋마다 세기, 기준, 켜기/끄기, 진동 위치, 기통 수, 변속기를 통째로 따로 둡니다. 트럭과 트립 모드의 승용차처럼 탈것이 바뀔 때 눌러서 바로 바꿉니다. 주행 중에도 즉시 적용되고 다음 실행에도 이어집니다."
msgstr "У каждого пресета свои силы, пороги, переключатели, выходы, число цилиндров и коробку передач. Нажмите его при смене машины, например между грузовиком и легковым автомобилем режима Trip. Применяется сразу, даже в движении, и сохраняется до следующего запуска."

msgid "플러그인"
msgstr "Плагин"

msgid "플러그인 설치"
msgstr "Установка плагина"

msgid "호환되는 텔레메트리 플러그인이 없습니다 → '텔레메트리 플러그인'"
msgstr "Нет совместимого плагина телеметрии → «Плагин телеметрии»"

msgid "회전 각속도 부호 뒤집음 (바퀴 속도 기준)"
msgstr "Знак скорости рыскания изменён (по скорости колёс)"

msgid "효과 테스트"
msgstr "Проверка эффекта"

msgid "효과 테스트: {name}"
msgstr "Проверка эффекта: {name}"

msgid "휠스핀"
msgstr "Пробуксовка"

msgid "흙"
msgstr "Грунт"

msgid "＋ 지금 설정으로 새 프리셋"
msgstr "＋ Новый из текущих"
