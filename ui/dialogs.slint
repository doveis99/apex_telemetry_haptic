// The telemetry plugin dialog and the motor calibration (gui.py's PluginDialog and
// CalibrationDialog). Rust fills them and acts on what they report.

import { Theme, TipArea, TipOverlay, Button, Switch, TipText } from "widgets.slint";

export struct GameRow {
    key: string,
    name: string,
    path: string,
    describe: string,
    button: string,
}

export component PluginDialog inherits Window {
    in property <[GameRow]> games;
    in property <string> ui-font;
    callback install(string);
    callback pick-folder();
    callback close-clicked();
    out property <length> content-width: body.preferred-width;
    out property <length> content-height: body.preferred-height;
    title: @tr("텔레메트리 플러그인");
    background: Theme.bg;
    default-font-family: root.ui-font;
    default-font-size: Theme.pt10;
    min-width: body.preferred-width;
    max-width: body.preferred-width;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    body := VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text {
            text: @tr("진동은 게임의 텔레메트리 플러그인(RenCloud 계열 rev 12) 데이터를 사용합니다.");
            color: Theme.text;
        }
        Rectangle { height: 4px; }
        if root.games.length == 0: Text {
            text: @tr("Steam에서 ATS/ETS2 설치를 찾지 못했습니다. 게임 폴더를 직접 선택하세요.");
            color: Theme.text;
        }
        for game in root.games: HorizontalLayout {
            spacing: 8px;
            TipText {
                width: 210px;
                text: game.name;
                tip: game.path;
                color: Theme.text;
            }
            Text {
                min-width: 240px;
                text: game.describe;
                color: Theme.text;
                vertical-alignment: center;
            }
            Button {
                text: game.button;
                height: 30px;
                min-w: 90px;
                tip: @tr("동봉한 RenCloud scs-telemetry.dll을 이 게임의 plugins 폴더에 복사합니다. 다른 플러그인은 건드리지 않습니다.");
                clicked => { root.install(game.key); }
            }
        }
        HorizontalLayout {
            padding-top: 10px;
            Button {
                text: @tr("게임 폴더 직접 선택…");
                height: 30px;
                tip: @tr("Steam 밖에 설치했거나 찾지 못한 경우, bin\\win_x64\\amtrucks.exe 또는 eurotrucks2.exe가 있는 게임 폴더를 지정합니다.");
                clicked => { root.pick-folder(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("닫기");
                height: 30px;
                min-w: 90px;
                clicked => { root.close-clicked(); }
            }
        }
    }
    TipOverlay {
        window-width: root.width;
        window-height: root.height;
    }
}

// A button with the pad and keyboard buttons that give the same answer written under it.
component AnswerButton inherits VerticalLayout {
    in property <string> text;
    in property <string> kind;
    in property <string> pad;   // "Pad ← / LB", translated by Rust
    in property <string> keys;
    in property <length> min-w: 120px;
    callback clicked();
    spacing: 0px;
    alignment: start;
    Button {
        text: root.text;
        kind: root.kind;
        min-w: root.min-w;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.pad;
        color: Theme.muted;
        font-size: Theme.pt9;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: root.keys;
        color: Theme.faint;
        font-size: Theme.pt8;
        horizontal-alignment: center;
    }
}

export component CalibrationDialog inherits Window {
    in property <string> ui-font;
    in property <string> screen: "start";   // start, session, end
    // start
    in property <string> sources;
    in property <string> grip-label;
    in property <string> trigger-label;
    in property <bool> grip-on: true;
    in property <bool> trigger-on: true;
    // session
    in property <string> progress;
    in property <string> trial;
    in property <string> state;
    // the pad and keyboard buttons under the answers: first, second, replay, stop
    in property <[string]> pads: ["", "", "", ""];
    in property <[string]> keyboard: ["", "", "", ""];
    // end
    in property <string> result;
    in property <[string]> curves;
    callback channel-toggled(string, bool);
    callback begin();
    callback reset();
    callback close-clicked();
    callback answer(string);  // first, second, replay, cancel
    callback restart();
    out property <length> content-height: body.preferred-height;
    title: @tr("모터 보정");
    background: Theme.bg;
    default-font-family: root.ui-font;
    default-font-size: Theme.pt10;
    width: 506px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    property <string> hint: @tr("컨트롤러를 평소처럼 잡으세요. 패드 버튼으로 답할 수 있습니다: 십자키 ← 또는 LB 첫 번째, → 또는 RB 두 번째, X 다시 듣기, B 그만. 키보드는 ← → (또는 1 2) R Esc입니다. 재생 중에 눌러도 바로 반영됩니다.");
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == "1") {
                root.answer("first");
            } else if (event.text == Key.RightArrow || event.text == "2") {
                root.answer("second");
            } else if (event.text == "r" || event.text == "R") {
                root.answer("replay");
            } else if (event.text == Key.Escape) {
                root.answer("cancel");
            } else {
                return reject;
            }
            accept
        }
        body := VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 0px;
            if root.screen == "start": VerticalLayout {
                spacing: 0px;
                Text {
                    text: @tr("모터는 그립 약 65Hz, 트리거 약 100Hz에서 가장 세게 울려서, 같은 세기로 보내도 주파수마다 다르게 느껴집니다. 이웃한 두 주파수가 차례로 울리면 어느 쪽이 더 셌는지 고르세요. 조금이라도 센 쪽이 있으면 그쪽을, 정말 구분이 안 되면 아무 쪽이나 고르면 됩니다. 구분이 안 된다는 건 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 답에 따라 세기를 좁혀 가며 같게 느껴지는 지점을 찾고, 모든 효과가 주파수별로 그만큼 보정됩니다. 모터 하나에 3~5분 걸립니다.");
                    color: Theme.text;
                    wrap: word-wrap;
                    width: 470px;
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.sources;
                    color: Theme.muted;
                    wrap: word-wrap;
                    width: 470px;
                }
                Rectangle { height: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: root.grip-on;
                            tint: Theme.grip;
                            toggled(on) => { root.channel-toggled("grip", on); }
                        }
                    }
                    Text {
                        text: root.grip-label;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 14px; }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: root.trigger-on;
                            tint: Theme.trigger;
                            toggled(on) => { root.channel-toggled("trigger", on); }
                        }
                    }
                    Text {
                        text: root.trigger-label;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 12px; }
                Text {
                    text: root.hint;
                    color: Theme.muted;
                    wrap: word-wrap;
                    width: 470px;
                }
                Rectangle { height: 16px; }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("시작");
                        kind: "primary";
                        min-w: 96px;
                        clicked => { root.begin(); }
                    }
                    Button {
                        text: @tr("보정 지우기");
                        tip: @tr("저장된 보정을 지워 기본값으로 되돌립니다.");
                        clicked => { root.reset(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: @tr("닫기");
                        clicked => { root.close-clicked(); }
                    }
                }
            }
            if root.screen == "session": VerticalLayout {
                spacing: 0px;
                Text {
                    text: root.progress;
                    color: Theme.text;
                    font-size: Theme.pt13;
                    font-weight: 700;
                }
                Rectangle { height: 4px; }
                Text {
                    text: root.trial;
                    color: Theme.muted;
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.state;
                    color: Theme.text;
                }
                Rectangle { height: 4px; }
                Text {
                    text: @tr("조금이라도 센 쪽이 있으면 그쪽을, 구분이 안 되면 아무 쪽이나 고르세요. 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 재생 중에 눌러도 바로 반영됩니다.");
                    color: Theme.muted;
                    font-size: Theme.pt9;
                    wrap: word-wrap;
                    width: 470px;
                }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    spacing: 8px;
                    AnswerButton {
                        text: @tr("◀ 첫 번째");
                        kind: "primary";
                        pad: root.pads[0];
                        keys: root.keyboard[0];
                        clicked => { root.answer("first"); }
                    }
                    AnswerButton {
                        text: @tr("두 번째 ▶");
                        kind: "primary";
                        pad: root.pads[1];
                        keys: root.keyboard[1];
                        clicked => { root.answer("second"); }
                    }
                    AnswerButton {
                        text: @tr("↻ 다시 듣기");
                        kind: "ghost";
                        pad: root.pads[2];
                        keys: root.keyboard[2];
                        clicked => { root.answer("replay"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    AnswerButton {
                        text: @tr("그만");
                        kind: "danger";
                        pad: root.pads[3];
                        keys: root.keyboard[3];
                        min-w: 0px;
                        clicked => { root.answer("cancel"); }
                    }
                }
            }
            if root.screen == "end": VerticalLayout {
                spacing: 0px;
                Text {
                    text: root.result;
                    color: Theme.text;
                    wrap: word-wrap;
                    width: 470px;
                }
                for line in root.curves: VerticalLayout {
                    padding-top: 6px;
                    Text {
                        text: line;
                        color: Theme.muted;
                        font-size: Theme.pt9;
                        wrap: word-wrap;
                    width: 470px;
                    }
                }
                Rectangle { height: 16px; }
                HorizontalLayout {
                    Button {
                        text: @tr("다시 보정");
                        clicked => { root.restart(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: @tr("닫기");
                        kind: "primary";
                        min-w: 96px;
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }
    }
    init => { keys.focus(); }
    TipOverlay {
        window-width: root.width;
        window-height: root.height;
    }
}
