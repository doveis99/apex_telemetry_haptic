msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

msgid "'{name}' 프리셋을 지울까요? 지금 설정은 그대로 남습니다."
msgstr "プリセット「{name}」を削除しますか？今の設定はそのまま残ります。"

msgid "'{name}' 프리셋이 이미 있습니다. 덮어쓸까요?"
msgstr "プリセット「{name}」はすでにあります。上書きしますか？"

msgid "2 kHz 출력"
msgstr "2 kHz 出力"

msgid "2 kHz 출력: 4 ms마다 2 kHz 샘플을 보냄"
msgstr "2 kHz 出力：4 ms ごとに 2 kHz サンプルを送信"

msgid "2 kHz 출력을 끄고 1 kHz로 돌아감"
msgstr "2 kHz 出力をオフにして 1 kHz に戻しました"

msgid "4 ms마다 리포트를 못 받음 (보낸 것 {percent})"
msgstr "4 ms ごとのレポートが届かず（送信 {percent}）"

msgid "AMT·수동"
msgstr "AMT・マニュアル"

msgid "APEX 6 Pro가 아님 (device type 0x{type})"
msgstr "APEX 6 Pro ではありません（device type 0x{type}）"

msgid "ATS 또는 ETS2 설치 폴더"
msgstr "ATS または ETS2 のインストールフォルダー"

msgid "ATS 햅틱"
msgstr "ATS ハプティクス"

msgid "ATS/ETS2 게임"
msgstr "ATS/ETS2 ゲーム"

msgid "ATS/ETS2 게임: 게임 텔레메트리로 진동을 만듭니다. 게임이 실행 중일 때만 컨트롤러를 씁니다.\n테스트 주행: 게임 없이 옆의 ▾에서 고른 주행을 재생합니다. 효과 확인과 튜닝용입니다.\n실행 중에는 바꿀 수 없습니다."
msgstr "ATS/ETS2 ゲーム: ゲームのテレメトリーで振動を作ります。ゲーム実行中だけコントローラーを使います。\nテスト走行: ゲームなしで、隣の ▾ で選んだ走行を再生します。エフェクトの確認と調整用です。\n実行中は変更できません。"

msgid "GitHub 저장소 열기: 소스 코드, 릴리스, 문의(Issues)"
msgstr "GitHub リポジトリを開く: ソースコード、リリース、問い合わせ（Issues）"

msgid "H-시프터의 레인지 셀렉터나 스플리터를 조작할 때 '딸깍'에 이어 변속기가 '철컥' 넘어갑니다(스플리터는 약하게). 자동/순차 변속에서는 울리지 않습니다."
msgstr "H シフターのレンジセレクターやスプリッターを操作すると「カチッ」に続いてトランスミッションが「ガチャッ」と切り替わります（スプリッターは弱め）。オートマ/シーケンシャルでは鳴りません。"

msgid "Steam 밖에 설치했거나 찾지 못한 경우, bin\\win_x64\\amtrucks.exe 또는 eurotrucks2.exe가 있는 게임 폴더를 지정합니다."
msgstr "Steam 以外のインストールや見つからない場合に、bin\\win_x64\\amtrucks.exe または eurotrucks2.exe があるゲームフォルダーを指定します。"

msgid "Steam에서 ATS/ETS2 설치를 찾지 못했습니다. 게임 폴더를 직접 선택하세요."
msgstr "Steam で ATS/ETS2 のインストールが見つかりません。ゲームフォルダーを直接選んでください。"

msgid "bin\\win_x64\\amtrucks.exe 또는 eurotrucks2.exe가 있는 게임 폴더를 선택하세요."
msgstr "bin\\win_x64\\amtrucks.exe または eurotrucks2.exe があるゲームフォルダーを選んでください。"

msgid "{error} · {seconds}초 후 재시도"
msgstr "{error} · {seconds} 秒後に再試行"

msgid "{game}의 plugins 폴더에 RenCloud scs-telemetry.dll(v1.12.1, MIT)을 복사합니다."
msgstr "{game} の plugins フォルダーに RenCloud scs-telemetry.dll（v1.12.1、MIT）をコピーします。"

msgid "{names} (호환 미확인)"
msgstr "{names}（互換性未確認）"

msgid "{name} ({count}개 주파수)"
msgstr "{name}（{count} 周波数）"

msgid "{name} (기본값)"
msgstr "{name}（既定値）"

msgid "{name} (직접 측정)"
msgstr "{name}（自分で測定）"

msgid "{name} {index}/{count} · {freq} Hz ↔ {neighbour} Hz"
msgstr "{name} {index}/{count} · {freq} Hz ↔ {neighbour} Hz"

msgid "{name} 연결됨. Ctrl+C로 종료."
msgstr "{name} に接続しました。Ctrl+C で終了。"

msgid "{name} 플러그인 버전 {revision} (지원: {supported})"
msgstr "{name} プラグインのリビジョン {revision}（対応: {supported}）"

msgid "↻ 다시 듣기"
msgstr "↻ もう一度"

msgid "└ 엔진 박자"
msgstr "└ エンジンの脈動"

msgid "■  정지"
msgstr "■  停止"

msgid "▶  시작"
msgstr "▶  開始"

msgid "◀ 첫 번째"
msgstr "◀ 1 つ目"

msgid "✓ '{name}'(으)로 바꿈"
msgstr "✓ 「{name}」に切り替えました"

msgid "✓ '{name}'에 저장됨"
msgstr "✓ 「{name}」に保存しました"

msgid "✓ 저장됨"
msgstr "✓ 保存しました"

msgid "가속도 최대"
msgstr "最大加速度"

msgid "가속도가 순간적으로 크게 튀면(충돌, 큰 충격) 강한 50Hz 펄스를 냅니다. 기준은 '충돌 감지 기준'에서 정합니다."
msgstr "加速度が瞬間的に大きく跳ねると（衝突、大きな衝撃）強い 50Hz のパルスを出します。基準は「衝突しきい値」で決めます。"

msgid "감지 기준"
msgstr "検出しきい値"

msgid "게임 감지 시 자동 시작"
msgstr "ゲーム検出で自動開始"

msgid "게임 값 그대로입니다. 후진 기어는 음수, 중립은 0입니다."
msgstr "ゲームの値そのままです。後退ギアはマイナス、ニュートラルは 0 です。"

msgid "게임 대기 중 (ATS/ETS2 실행 전)"
msgstr "ゲーム待機中（ATS/ETS2 未起動）"

msgid "게임 알림"
msgstr "ゲーム通知"

msgid "게임 종료 시 닫힘"
msgstr "ゲーム終了時に閉じる"

msgid "게임 종료됨, 컨트롤러 해제"
msgstr "ゲーム終了、コントローラーを解放しました"

msgid "게임 폴더 직접 선택…"
msgstr "ゲームフォルダーを選ぶ…"

msgid "게임 화면 한 프레임 사이의 가속도 변화가 이 값을 넘으면 충돌 펄스를 냅니다. 평소 주행 중 '가속도 최대' 값보다 충분히 높게 두세요."
msgstr "ゲーム画面の 1 フレームの間の加速度変化がこの値を超えると衝突パルスを出します。普段の走行中の「最大加速度」より十分高くしてください。"

msgid "게임에 설치된 텔레메트리 플러그인을 확인하고, 없으면 동봉한 플러그인을 설치합니다."
msgstr "ゲームに入っているテレメトリープラグインを確認し、なければ同梱のプラグインをインストールします。"

msgid "게임에서 받고 있는 값"
msgstr "ゲームから受信中の値"

msgid "게임이 실행 중이면 다음 실행부터 적용됩니다."
msgstr "ゲームが実行中なら、次回の起動から有効になります。"

msgid "게임이 실행 중입니다. 게임을 끝낸 뒤 업데이트하세요."
msgstr "ゲームが実行中です。ゲームを終了してからアップデートしてください。"

msgid "고속도로 4분"
msgstr "高速道路 4 分"

msgid "그립"
msgstr "グリップ"

msgid "그만"
msgstr "やめる"

msgid "그만두는 중…"
msgstr "やめています…"

msgid "금속"
msgstr "金属"

msgid "기록 {date}"
msgstr "記録 {date}"

msgid "기록 폴더 ↗"
msgstr "記録フォルダー ↗"

msgid "기본 60초"
msgstr "基本 60 秒"

msgid "기본값"
msgstr "既定値"

msgid "기어"
msgstr "ギア"

msgid "기어가 바뀔 때 '철컥'. 주행 진동이 잠깐 비었다가 단단하게 맞물리는 느낌입니다. 자동 변속기도 동작합니다. '변속기'를 토크컨버터로 두면 '철컥' 대신 부드럽게 '쿵' 밀어 줍니다."
msgstr "ギアが変わるたびに「ガチャン」。走行振動が一瞬途切れてから、しっかり噛み合う感触です。オートマでも動作します。「トランスミッション」をトルコンにすると、「ガチャン」の代わりにやわらかく「ドン」と押します。"

msgid "기차"
msgstr "列車"

msgid "나무"
msgstr "木"

msgid "내려받는 중 {percent}"
msgstr "ダウンロード中 {percent}"

msgid "내려받아 설치하고 프로그램을 다시 시작할까요?"
msgstr "ダウンロードしてインストールし、プログラムを再起動しますか?"

msgid "노면"
msgstr "路面"

msgid "노면 재질(얼음 < 아스팔트 < 콘크리트 < 눈 < 나무 < 금속 < 잔디 < 흙 < 자갈)과 속도로 세기와 질감이 정해집니다. 아스팔트는 고르게 '쉬익', 콘크리트는 이음매마다 '툭·툭', 나무는 판자가 '두두두', 금속은 '웅' 하고 울리고, 잔디·흙은 천천히 출렁이며, 자갈·흙·눈에는 돌이 튀는 '탁탁'이 섞입니다. 험한 길에서는 캡이 덜컹거립니다. 빠를수록 촘촘해지고, 왼쪽과 오른쪽 바퀴가 따로 갑니다."
msgstr "強さと質感は路面の材質（氷 < アスファルト < コンクリート < 雪 < 木 < 金属 < 芝生 < 土 < 砂利）と速度で決まります。アスファルトは均一な「シャー」、コンクリートは継ぎ目ごとに「コトッ・コトッ」、木は板が「ドドド」、金属は「ウォーン」と鳴り、芝生・土はゆっくりうねり、砂利・土・雪には小石が跳ねる「カタカタ」が混じります。荒れた道ではキャブがガタつきます。速いほど細かくなり、左右の車輪は別々に伝わります。"

msgid "노면은 재질을 골라 80 km/h로 그 위만 달려 보거나, 모든 재질을 차례로 달려 볼 수 있습니다."
msgstr "路面は材質を選んでその上だけを時速80 kmで走るか、すべての材質を順番に走ってみることができます。"

msgid "눈"
msgstr "雪"

msgid "다시 보정"
msgstr "もう一度補正"

msgid "다운로드한 파일의 해시가 릴리스와 다릅니다"
msgstr "ダウンロードしたファイルのハッシュがリリースと一致しません"

msgid "닫기"
msgstr "閉じる"

msgid "달리는 동안 계속 나는 진동"
msgstr "走行中ずっと続く振動"

msgid "동봉한 RenCloud scs-telemetry.dll을 이 게임의 plugins 폴더에 복사합니다. 다른 플러그인은 건드리지 않습니다."
msgstr "同梱の RenCloud scs-telemetry.dll をこのゲームの plugins フォルダーにコピーします。ほかのプラグインには触れません。"

msgid "두 번째 ▶"
msgstr "2 つ目 ▶"

msgid "둘 다"
msgstr "両方"

msgid "디버그 기록"
msgstr "デバッグ記録"

msgid "디버그 기록 재생…"
msgstr "デバッグ記録を再生…"

msgid "디버그 기록 종료"
msgstr "デバッグ記録を終了"

msgid "디버그 기록: {name}"
msgstr "デバッグ記録: {name}"

msgid "디버그 기록을 열 수 없음 ({error})"
msgstr "デバッグ記録を開けません ({error})"

msgid "디버그 기록이 쌓이는 폴더를 엽니다."
msgstr "デバッグ記録がたまるフォルダーを開きます。"

msgid "레인지 셀렉터"
msgstr "レンジセレクター"

msgid "레인지/스플리터"
msgstr "レンジ/スプリッター"

msgid "리타더"
msgstr "リターダー"

msgid "리타더 단계에 비례하는 웅웅거림으로, 빠를수록 음이 높아집니다(40~65Hz). 엔진 브레이크는 엔진 점화 박자에 맞춰 '다다닥' 노크하고, 엑셀을 밟으면 멈춥니다."
msgstr "リターダーの段数に比例するうなりで、速いほど音が高くなります（40〜65Hz）。エンジンブレーキはエンジンの点火リズムで「ダダダッ」とノックし、アクセルを踏むと止まります。"

msgid "릴리스 zip에 {exe}이 없습니다"
msgstr "リリース zip に {exe} がありません"

msgid "릴리스 zip을 풀지 못했습니다 (PowerShell {code})"
msgstr "リリースの zip を展開できませんでした (PowerShell {code})"

msgid "릴리스 페이지를 열까요?"
msgstr "リリースページを開きますか?"

msgid "모든 세기와 기준, 진동 위치를 기본값으로 되돌리고 모든 효과를 켭니다. 저장은 따로 눌러야 합니다."
msgstr "すべての強さ、しきい値、振動の場所を既定値に戻し、すべてのエフェクトをオンにします。保存は別に押してください。"

msgid "모터 보정"
msgstr "モーター補正"

msgid "모터 보정…"
msgstr "モーター補正…"

msgid "모터가 주파수마다 다르게 울리는 정도를 손으로 느끼며 맞춥니다. 결과는 모든 효과에 주파수별로 적용됩니다. 출력을 정지한 상태에서 씁니다."
msgstr "モーターが周波数ごとにどれだけ違って鳴るかを、手で感じながらそろえます。結果はすべてのエフェクトに周波数ごとにかかります。出力を停止した状態で使います。"

msgid "모터는 그립 약 65Hz, 트리거 약 100Hz에서 가장 세게 울려서, 같은 세기로 보내도 주파수마다 다르게 느껴집니다. 이웃한 두 주파수가 차례로 울리면 어느 쪽이 더 셌는지 고르세요. 조금이라도 센 쪽이 있으면 그쪽을, 정말 구분이 안 되면 아무 쪽이나 고르면 됩니다. 구분이 안 된다는 건 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 답에 따라 세기를 좁혀 가며 같게 느껴지는 지점을 찾고, 모든 효과가 주파수별로 그만큼 보정됩니다. 모터 하나에 3~5분 걸립니다."
msgstr "モーターはグリップ約 65Hz、トリガー約 100Hz でいちばん強く鳴るので、同じ強さで送っても周波数ごとに感じ方が違います。隣り合う 2 つの周波数が順に鳴るので、強く感じたほうを選んでください。少しでも強いほうがあればそちらを、本当に区別できなければどちらを選んでもかまいません。区別できないのはほぼ同じになったということなので、結果がずれることはありません。答えに合わせて同じ強さに感じる点を絞り込み、すべてのエフェクトが周波数ごとにその分だけ補正されます。モーター 1 つに 3〜5 分かかります。"

msgid "바뀐 설정을 저장할까요?"
msgstr "変更した設定を保存しますか?"

msgid "방향지시등"
msgstr "ウインカー"

msgid "방향지시등 우"
msgstr "ウインカー 右"

msgid "방향지시등 좌"
msgstr "ウインカー 左"

msgid "방향지시등이 점멸할 때마다 켜진 쪽 그립에 '틱'."
msgstr "ウインカーが点滅するたびに、点いている側のグリップに「カチ」。"

msgid "배송 완료"
msgstr "配送完了"

msgid "번들 플러그인이 없습니다: {path}"
msgstr "同梱プラグインがありません: {path}"

msgid "벌금"
msgstr "罰金"

msgid "변경됨 · 저장 안 됨"
msgstr "変更あり · 未保存"

msgid "변속"
msgstr "シフト"

msgid "변속 {gear}단"
msgstr "シフト {gear} 速"

msgid "변속, 충돌, 페달, 트레일러, 파킹 브레이크, 방향지시등, 시동, 게임 알림과 컨트롤러 연결 문제가 시간과 함께 기록됩니다. 최근 50개까지 보입니다."
msgstr "シフト、衝突、ペダル、トレーラー、パーキングブレーキ、ウインカー、エンジン始動、ゲーム通知、コントローラーの接続問題が時刻付きで記録されます。最新 50 件まで表示します。"

msgid "변속과 충돌을 포함한 모든 이벤트 효과가 울리는 순간, 같은 위치의 주행 진동을 잠깐 줄여 이벤트가 묻히지 않게 하는 정도입니다. 0%면 줄이지 않습니다."
msgstr "シフトや衝突を含むすべてのイベントエフェクトに効きます。イベントが鳴る瞬間、同じ場所の走行振動を一時的に弱めてイベントが埋もれないようにする度合いです。0% なら弱めません。"

msgid "변속기"
msgstr "トランスミッション"

msgid "변속할 때의 느낌입니다. AMT·수동은 레버가 빠지고 다음 기어가 '철컥' 들어갑니다(이튼 풀러, DT12 같은 변속기). 토크컨버터는 동력이 끊기지 않고 다음 기어가 물리며 부드럽게 '쿵' 밀어 줍니다(앨리슨). 엑셀을 깊이 밟을수록 단단하고, 발을 떼고 변속하면 거의 없습니다. 텔레메트리에는 변속기 종류가 없습니다."
msgstr "変速したときの感触です。AMT・マニュアルはレバーがギアから抜け、次のギアが「ガチャン」と入ります（イートン・フラー、DT12 などのトランスミッション）。トルコンは動力が途切れず、次のギアがつながるときにやわらかく「ドン」と押します（アリソン）。アクセルを深く踏むほど強く、アクセルを離して変速するとほとんどありません。テレメトリーにはトランスミッションの種類がありません。"

msgid "보정 지우기"
msgstr "補正を消去"

msgid "보정을 저장했습니다: {channels}. 다음 시작부터 적용됩니다."
msgstr "補正を保存しました: {channels}。次の開始から適用されます。"

msgid "보정하지 못했습니다: {error}"
msgstr "補正できませんでした: {error}"

msgid "복사하지 못했습니다: {error}"
msgstr "コピーできませんでした: {error}"

msgid "브레이크"
msgstr "ブレーキ"

msgid "브레이크 스퀼"
msgstr "ブレーキ鳴き"

msgid "브레이크 페달을 떼면 브레이크 챔버의 공기가 빠지며 '툭' 하고 짧게 '푸쉬익'. 세게 밟았을수록 크고, 잠깐 톡 친 정도로는 나지 않습니다. 브레이크를 뗄 때마다 나므로 '주행 진동 양보'로 주행 진동을 줄이지 않습니다."
msgstr "ブレーキペダルを離すとブレーキチャンバーのエアが抜けて「トン」と短い「プシュー」。強く踏んだほど大きく、軽く触れただけでは出ません。離すたびに出るので、「イベント優先」で走行振動を弱めません。"

msgid "비교 {trial}번째"
msgstr "比較 {trial} 回目"

msgid "삭제"
msgstr "削除"

msgid "산길 3분"
msgstr "山道 3 分"

msgid "새 버전 {new}이 있습니다 (현재 {current})."
msgstr "新しいバージョン {new} があります（現在 {current}）。"

msgid "새 버전의 릴리스 노트를 보고, 내려받아 설치한 뒤 다시 시작합니다. 설정은 그대로입니다."
msgstr "新しいバージョンのリリースノートを表示し、ダウンロードとインストールをして再起動します。設定はそのままです。"

msgid "새 프리셋"
msgstr "新しいプリセット"

msgid "서스펜션이 이 속도보다 갑자기 빨리 움직이면 요철 펄스를 냅니다. 낮추면 작은 요철에도, 높이면 큰 충격에만 반응합니다. 트럭이 평소에 많이 흔들리면 기준이 저절로 그만큼 올라갑니다."
msgstr "サスペンションがこの速さより急に速く動くと段差パルスを出します。下げると小さな段差にも、上げると大きな衝撃だけに反応します。トラックが普段から大きく揺れる場合は、基準が自動でその分上がります。"

msgid "설정 파일을 읽을 수 없어 기본값으로 시작했습니다. 저장하면 원래 파일은 {name}(으)로 남습니다."
msgstr "設定ファイルを読み込めなかったため、既定値で起動しました。保存すると、元のファイルは {name} として残ります。"

msgid "설치"
msgstr "インストール"

msgid "설치 중…"
msgstr "インストール中…"

msgid "설치했습니다."
msgstr "インストールしました。"

msgid "속도"
msgstr "速度"

msgid "순간적으로 한 번 나는 진동"
msgstr "一瞬だけの振動"

msgid "스플리터"
msgstr "スプリッター"

msgid "슬라이더, 켜기/끄기, 진동 위치를 %APPDATA%\\ATSHaptics\\config.json에 저장합니다. 프리셋을 쓰는 중이면 그 프리셋에도 저장합니다. 저장하지 않은 변경이 있으면 버튼이 파랗게 바뀝니다."
msgstr "スライダー、オン/オフ、振動の場所を %APPDATA%\\ATSHaptics\\config.json に保存します。プリセットを使っているときはそのプリセットにも保存します。未保存の変更があるとボタンが青くなります。"

msgid "시내 2분 30초"
msgstr "市街地 2 分 30 秒"

msgid "시동"
msgstr "エンジン始動"

msgid "시동 끔"
msgstr "エンジン停止"

msgid "시동 켜기/끄기"
msgstr "エンジン始動/停止"

msgid "시동을 켤 때 1초쯤 크랭킹하다가 '부웅' 하고 걸리고, 끌 때 잠깐 더 돌다가 '투둑투둑' 잦아듭니다."
msgstr "エンジン始動時は 1 秒ほどクランキングしてから「ブォン」とかかり、停止時は少し回り続けてから「トトトッ」と止まります。"

msgid "시작"
msgstr "開始"

msgid "시작 중"
msgstr "開始中"

msgid "아스팔트"
msgstr "アスファルト"

msgid "아스팔트 → 자갈"
msgstr "アスファルト → 砂利"

msgid "약 14km/h 이하에서 브레이크를 밟으며 서서히 멈출 때 '끼익, 끽' 하고 끊어지며 우는 가는 진동입니다."
msgstr "約 14km/h 以下でブレーキを踏みながらゆっくり止まるときに「キーッ、キッ」と途切れながら鳴く細い振動です。"

msgid "어느 쪽이 더 셌나요?"
msgstr "どちらが強かったですか？"

msgid "얼음"
msgstr "氷"

msgid "업데이트"
msgstr "アップデート"

msgid "업데이트 {version}"
msgstr "アップデート {version}"

msgid "업데이트하지 못했습니다: {error}"
msgstr "アップデートできませんでした: {error}"

msgid "없음"
msgstr "なし"

msgid "에어 브레이크"
msgstr "エアブレーキ"

msgid "엑셀"
msgstr "アクセル"

msgid "엑셀 {throttle} / 브레이크 {brake}"
msgstr "アクセル {throttle} / ブレーキ {brake}"

msgid "엑셀 트리거 진동을 엔진 점화 박자에 맞춰 출렁이게 하는 정도입니다. 엔진 진동과 같은 폭발을 따라가서 공회전의 울렁임과 폭발마다 다른 세기도 느껴집니다. 0%면 일정하게 울립니다. 브레이크 쪽에는 영향이 없습니다."
msgstr "アクセルのトリガー振動をエンジンの点火リズムに合わせて揺らす度合いです。エンジン振動と同じ爆発に合わせるので、アイドリングのうねりや爆発ごとの強さの違いも伝わります。0% なら一定に鳴ります。ブレーキには影響しません。"

msgid "엑셀/브레이크"
msgstr "アクセル/ブレーキ"

msgid "엑셀/브레이크 입력(0~1)입니다. 크루즈 컨트롤처럼 게임이 대신 밟는 값은 포함하지 않습니다."
msgstr "アクセル/ブレーキの入力（0〜1）です。クルーズコントロールのようにゲームが代わりに踏む分は含みません。"

msgid "엑셀을 밟는데 구동 바퀴가 트럭보다 빨리 헛돌면(얼음, 눈, 진흙, 급출발) 양쪽 그립에 거칠게 긁히는 진동을 냅니다. 브레이크로 바퀴가 잠기는 휠락은 '엑셀/브레이크'에서 냅니다."
msgstr "アクセルを踏んで駆動輪がトラックより速く空転すると（氷、雪、泥、急発進）、両方のグリップにざらついた振動を出します。ブレーキで車輪がロックするのは「アクセル/ブレーキ」で出します。"

msgid "엑셀이나 브레이크를 끝까지(97% 이상) 밟는 순간 짧은 '툭'."
msgstr "アクセルかブレーキを奥まで（97% 以上）踏んだ瞬間に短く「トン」。"

msgid "엔진"
msgstr "エンジン"

msgid "엔진 기통 수"
msgstr "気筒数"

msgid "엔진 점화 주파수(rpm ÷ 60 × 기통 수 ÷ 2)에 2배음을 더한 진동입니다. 엑셀을 밟을수록, rpm이 높을수록 세집니다. 공회전에서는 실린더마다 폭발이 고르지 않아 울렁이고, 부하가 크면 거칠어집니다. 시동이 꺼져 있으면 없습니다. 차가 멈춰 서면 공회전 진동이 최대 3배로 커집니다."
msgstr "エンジンの点火周波数（rpm ÷ 60 × 気筒数 ÷ 2）に 2 倍音を加えた振動です。アクセルを踏むほど、rpm が高いほど強くなります。アイドリングでは気筒ごとの爆発が不ぞろいでうねり、負荷が大きいと荒くなります。エンジン停止中は出ません。停車するとアイドリングの振動が最大 3 倍になります。"

msgid "엔진 진동 주파수 계산에 씁니다. ATS 순정 트럭은 대부분 직렬 6기통이고, ETS2의 Scania V8 같은 트럭은 8로 두세요. 텔레메트리에는 기통 수가 없습니다."
msgstr "エンジン振動の周波数計算に使います。ATS の純正トラックはほとんど直列 6 気筒です。ETS2 の Scania V8 のようなトラックは 8 にしてください。テレメトリーには気筒数がありません。"

msgid "엔진(rpm·부하), 노면(재질·속도), 엑셀/브레이크(페달)가 그대로 유지되면 그 진동을 수십 초에 걸쳐 이 비율만큼 줄입니다. 변함없는 진동은 손이 곧 느끼지 못하고 피로만 쌓이기 때문입니다. 가속·감속, 변속, 노면이 바뀌거나 페달을 움직이면 바로 돌아오고, 크루즈 중 작은 속도 변화나 손가락 떨림은 무시합니다."
msgstr "エンジン（rpm・負荷）、路面（材質・速度）、アクセル/ブレーキ（ペダル）が一定のままだと、その振動を数十秒かけてこの割合だけ弱めます。変わらない振動は手がすぐ感じなくなり、疲れだけが残るためです。加速・減速、シフト、路面の変化、ペダル操作ですぐ戻り、クルーズ中の小さな速度変化や指の震えは無視します。"

msgid "오류: {error}"
msgstr "エラー: {error}"

msgid "오른쪽 그립"
msgstr "右グリップ"

msgid "왼쪽 그립"
msgstr "左グリップ"

msgid "요철"
msgstr "段差"

msgid "요철 감지 기준"
msgstr "段差しきい値"

msgid "이 모터로 실제로 나가는 세기입니다. 진동이 약하거나 없을 때 어느 단계에서 줄어드는지 확인하세요."
msgstr "このモーターへ実際に出ている強さです。振動が弱い・ないときに、どの段階で小さくなるかを確認してください。"

msgid "이 프리셋으로 바꿉니다. 오른쪽 클릭: 이름 바꾸기, 삭제"
msgstr "このプリセットに切り替えます。右クリック: 名前の変更、削除"

msgid "이 효과 켜기/끄기. 꺼도 세기와 진동 위치는 남아서 다시 켜면 그대로 돌아옵니다."
msgstr "このエフェクトのオン/オフ。オフにしても強さと振動の場所は残り、オンに戻すとそのまま復帰します。"

msgid "이 효과만 몇 초 동안 울려 봅니다. 지금 세기, 진동 위치, 모터 보정 그대로이고, 꺼 둔 효과도 울립니다. 요철, 차선 요철, 방향지시등은 왼쪽 다음 오른쪽 순서입니다. 출력 중에는 그동안 주행 진동 대신 울립니다."
msgstr "このエフェクトだけを数秒間鳴らします。いまの強さ、振動の場所、モーター補正のままで、オフにしたエフェクトも鳴ります。段差、ランブルストリップ、ウインカーは左、次に右の順です。出力中はその間、走行振動の代わりに鳴ります。"

msgid "이 효과의 진동이 갈 곳: 그립(파랑), 트리거(주황), 둘 다(보라). 꺼진 효과에서 위치를 누르면 그 위치로 다시 켜집니다."
msgstr "このエフェクトの振動先: グリップ（青）、トリガー（オレンジ）、両方（紫）。オフのエフェクトで場所を押すと、その場所で再びオンになります。"

msgid "이름 바꾸기"
msgstr "名前の変更"

msgid "이름 바꾸기…"
msgstr "名前の変更…"

msgid "이벤트"
msgstr "イベント"

msgid "이벤트 효과"
msgstr "イベントエフェクト"

msgid "일시정지/메뉴"
msgstr "一時停止/メニュー"

msgid "입력"
msgstr "入力"

msgid "자갈"
msgstr "砂利"

msgid "잔디"
msgstr "芝生"

msgid "재생할 디버그 기록"
msgstr "再生するデバッグ記録"

msgid "재설치"
msgstr "再インストール"

msgid "저장"
msgstr "保存"

msgid "저장된 보정을 지우고 기본값으로 되돌릴까요?"
msgstr "保存した補正を消去して既定値に戻しますか？"

msgid "저장된 보정을 지워 기본값으로 되돌립니다."
msgstr "保存した補正を消去して既定値に戻します。"

msgid "저장하지 못했습니다: {error}"
msgstr "保存できませんでした: {error}"

msgid "저장하지 않은 변경이 있습니다. 바꾸기 전에 저장할까요?"
msgstr "保存していない変更があります。切り替える前に保存しますか？"

msgid "저장한 보정이 없습니다. 모터 하나를 끝까지 맞추면 저장됩니다."
msgstr "保存した補正はありません。モーター 1 つを最後まで合わせると保存されます。"

msgid "전부 차례로 (얼음 → 자갈, 각 {seconds}초)"
msgstr "すべて順番に（氷 → 砂利、各{seconds}秒）"

msgid "전체"
msgstr "全体"

msgid "정속 시 줄임"
msgstr "定速時に弱める"

msgid "정지 중…"
msgstr "停止中…"

msgid "정지됨"
msgstr "停止中"

msgid "조금이라도 센 쪽이 있으면 그쪽을, 구분이 안 되면 아무 쪽이나 고르세요. 거의 같아졌다는 뜻이라 결과가 틀어지지 않습니다. 재생 중에 눌러도 바로 반영됩니다."
msgstr "少しでも強いほうがあればそちらを、区別できなければどちらでも選んでください。ほぼ同じになったということなので、結果はずれません。再生中に押してもすぐ反映されます。"

msgid "종료: 모터 해제 완료."
msgstr "終了: モーターを解放しました。"

msgid "좌우 그립 모터에만 적용되는 최종 세기입니다."
msgstr "左右のグリップモーターだけにかかる最終的な強さです。"

msgid "주유"
msgstr "給油"

msgid "주행 중 ({source})"
msgstr "走行中（{source}）"

msgid "주행 진동 양보"
msgstr "イベント優先"

msgid "주행 효과"
msgstr "走行エフェクト"

msgid "중앙선이나 갓길의 차선 요철(럼블 스트립)을 밟은 쪽 그립에 '드르르륵'. 게임이 알려 주는 노면 재질로 감지하고, 빠를수록 촘촘해집니다."
msgstr "センターラインや路肩のランブルストリップを踏んだ側のグリップに「ドドドド」。ゲームが知らせる路面の材質で検出し、速いほど細かくなります。"

msgid "지금 밟고 있는 페달을 따라가는 트리거 진동입니다. 엑셀은 밟은 만큼 세지고, 브레이크는 바퀴가 잠기면(휠락) 끊기는 펄스를 냅니다."
msgstr "いま踏んでいるペダルに合わせたトリガー振動です。アクセルは踏んだぶん強くなり、ブレーキは車輪がロックすると途切れるパルスを出します。"

msgid "지금 보정: {channels}"
msgstr "現在の補正: {channels}"

msgid "지금 설정(저장하지 않은 변경 포함)을 새 이름으로 보관하고 그 프리셋으로 바꿉니다."
msgstr "今の設定（未保存の変更を含む）を新しい名前で保存し、そのプリセットに切り替えます。"

msgid "지난 세션: 지연 프레임 {late} / 최대 {max} ms"
msgstr "前回のセッション: 遅延フレーム {late} / 最大 {max} ms"

msgid "직전 세션에서 8ms 출력 주기를 놓친 횟수와 가장 늦었던 시간입니다. 0에 가까우면 정상입니다."
msgstr "前回のセッションで 8ms の出力周期を逃した回数と、最も遅れた時間です。0 に近ければ正常です。"

msgid "진동 위치"
msgstr "振動の場所"

msgid "진동 출력을 시작하거나 멈춥니다. 정지하면 모터를 끄고 컨트롤러를 놓습니다."
msgstr "振動出力を開始・停止します。停止するとモーターを止めてコントローラーを解放します。"

msgid "진동은 게임의 텔레메트리 플러그인(RenCloud 계열 rev 12) 데이터를 사용합니다."
msgstr "振動はゲームのテレメトリープラグイン（RenCloud 系 rev 12）のデータを使います。"

msgid "차선 요철"
msgstr "ランブルストリップ"

msgid "창이 정지 상태일 때 게임이 실행되면 자동으로 시작합니다. 게임 도중 직접 정지하면 그 게임이 끝날 때까지는 다시 켜지지 않습니다. 바꾸면 바로 저장됩니다."
msgstr "ウィンドウが停止中にゲームが起動すると自動で開始します。ゲーム中に手動で停止すると、そのゲームが終わるまで再開しません。切り替えるとすぐ保存されます。"

msgid "첫 번째 → 두 번째 재생 중…"
msgstr "1 つ目 → 2 つ目を再生中…"

msgid "첫 번째 바퀴 아래 노면 재질의 게임 내부 이름입니다(예: road, gravel, grass)."
msgstr "最初の車輪の下にある路面材質のゲーム内部名です（例: road、gravel、grass）。"

msgid "최근 0.1초 동안 수평 가속도 최대값입니다. 충돌 감지 기준을 정할 때 참고하세요."
msgstr "直近 0.1 秒間の水平加速度の最大値です。衝突しきい値を決めるときの参考にしてください。"

msgid "출력 세기"
msgstr "出力の強さ"

msgid "출력 제어"
msgstr "出力制御"

msgid "출력을 정지한 다음 보정하세요."
msgstr "出力を停止してから補正してください。"

msgid "출력이 게임을 기다리는 중이라 지금은 컨트롤러를 쓰지 않습니다. 정지한 다음 테스트하세요."
msgstr "出力がゲームを待っているため、いまはコントローラーを使っていません。停止してからテストしてください。"

msgid "충돌"
msgstr "衝突"

msgid "충돌 {accel} m/s²"
msgstr "衝突 {accel} m/s²"

msgid "충돌 감지 기준"
msgstr "衝突しきい値"

msgid "컨트롤러 미사용"
msgstr "コントローラー未使用"

msgid "컨트롤러 상태 · 텔레메트리 상태\n점 색: 초록 출력 중, 노랑 컨트롤러 대기, 빨강 오류, 회색 정지"
msgstr "コントローラーの状態 · テレメトリーの状態\n点の色: 緑 出力中、黄 コントローラー待ち、赤 エラー、灰 停止"

msgid "컨트롤러 안 보임: Steam이 실행한 프로세스라 Steam Input이 패드를 숨김 (창을 따로 실행하거나 게임의 Steam Input 끄기)"
msgstr "コントローラーが見えません: Steam から起動されたため Steam Input がパッドを隠しています（ウィンドウを別に起動するか、ゲームの Steam Input をオフに）"

msgid "컨트롤러 없음"
msgstr "コントローラーなし"

msgid "컨트롤러 없음 (유선/2.4G 동글 연결, 전원 확인)"
msgstr "コントローラーなし（有線/2.4Gドングルの接続と電源を確認）"

msgid "컨트롤러 연결 끊김 ({error})"
msgstr "コントローラーの接続が切れました（{error}）"

msgid "컨트롤러 응답 없음 (절전 중이면 버튼을 눌러 깨우세요)"
msgstr "コントローラーが応答しません（スリープ中ならボタンを押して起こしてください）"

msgid "컨트롤러 해제. {stats}"
msgstr "コントローラーを解放しました。{stats}"

msgid "컨트롤러로 나가는 최종 세기입니다. 효과별 세기를 모두 섞은 다음 그립과 트리거 모두에 적용됩니다. 100%를 넘기면 약한 효과는 세지고 이미 센 효과는 거의 그대로입니다."
msgstr "コントローラーへ送る最終的な強さです。各エフェクトをミックスした後、グリップとトリガーの両方にかかります。100% を超えると弱いエフェクトは強くなり、もともと強いエフェクトはほぼそのままです。"

msgid "컨트롤러를 열 수 없음 ({error})"
msgstr "コントローラーを開けません（{error}）"

msgid "컨트롤러를 평소처럼 잡으세요. 패드 버튼으로 답할 수 있습니다: 십자키 ← 또는 LB 첫 번째, → 또는 RB 두 번째, X 다시 듣기, B 그만. 키보드는 ← → (또는 1 2) R Esc입니다. 재생 중에 눌러도 바로 반영됩니다."
msgstr "コントローラーはいつも通りに握ってください。パッドのボタンでも答えられます: 十字キー ← または LB で 1 つ目、→ または RB で 2 つ目、X もう一度、B やめる。キーボードは ← →（または 1 2）R Esc です。再生中に押してもすぐ反映されます。"

msgid "켜 두면 시작할 때마다 컨트롤러로 보낸 8ms 블록을 하나씩 CSV로 남깁니다(시각, 주기 간격, 트리거 경로, 채널별 세기, 속도·노면·이벤트). 진동이 이상하면 그 시각을 기억해 두고 이 파일을 보세요. 1시간에 약 30MB, 최근 10개만 남깁니다. 주행 중에도 켜고 끄는 즉시 적용되고 바로 저장됩니다."
msgstr "オンにすると、開始するたびにコントローラーへ送った 8ms ブロックを 1 行ずつ CSV に残します（時刻、周期の間隔、トリガーの経路、チャンネル別の強さ、速度・路面・イベント）。振動がおかしいときはその時刻を覚えておき、このファイルで確認してください。1 時間で約 30MB、最新 10 個だけ残します。走行中でもすぐに適用され、すぐ保存されます。"

msgid "켜면 1 kHz 대신 2 kHz 샘플을 4ms마다 컨트롤러로 보냅니다. 진동 세기는 그대로 두고, 1 kHz로 보낼 때 패드가 같이 내던 500~1000 Hz 잔음을 걸러 내며, 딸깍(틱)은 더 날카롭게 냅니다. 무선에서 끊김이 잦아지면 끄세요. 주행이나 테스트 중에도 바로 바뀌고 바로 저장됩니다."
msgstr "オンにすると、1 kHz の代わりに 2 kHz のサンプルを 4ms ごとにコントローラーへ送ります。振動の強さはそのままで、1 kHz で送るときにパッドが一緒に出していた 500〜1000 Hz の雑音を取り除き、カチッ（ティック）をより鋭く出します。無線で途切れが増えたらオフにしてください。走行中やテスト中でもすぐに切り替わり、すぐ保存されます。"

msgid "콘크리트"
msgstr "コンクリート"

msgid "키보드 {keys}"
msgstr "キーボード {keys}"

msgid "테스트 주행"
msgstr "テスト走行"

msgid "테스트 주행이 재생할 주행입니다. 기본 60초는 모든 효과를 한 번씩, 고속도로·시내·산길은 효과가 겹치는 실제 주행 몇 분입니다. 디버그 기록 재생은 기록해 둔 주행을 지금 설정으로 다시 느껴 봅니다. 실행 중에는 바꿀 수 없습니다."
msgstr "テスト走行で再生する走行です。基本 60 秒はすべてのエフェクトを一度ずつ、高速道路・市街地・山道はエフェクトが重なる実際の走行数分です。デバッグ記録の再生は、記録した走行を今の設定でもう一度体験します。実行中は変更できません。"

msgid "텔레메트리"
msgstr "テレメトリー"

msgid "텔레메트리 대기 중 (게임 로딩 중이거나 플러그인 없음)"
msgstr "テレメトリー待機中（ゲーム読み込み中、またはプラグインなし）"

msgid "텔레메트리 멈춤 (최소화/로딩)"
msgstr "テレメトリー停止中（最小化/読み込み中）"

msgid "텔레메트리 없음: {problem} → '텔레메트리 플러그인'에서 설치"
msgstr "テレメトリーなし: {problem} →「テレメトリープラグイン」からインストール"

msgid "텔레메트리 플러그인"
msgstr "テレメトリープラグイン"

msgid "텔레메트리 플러그인 없음"
msgstr "テレメトリープラグインなし"

msgid "토크컨버터"
msgstr "トルコン"

msgid "톨게이트"
msgstr "料金所"

msgid "톨게이트, 벌금, 주유, 배송 완료, 페리, 기차 이벤트 때 '톡톡' 두 번."
msgstr "料金所、罰金、給油、配送完了、フェリー、列車のイベントで「トントン」と 2 回。"

msgid "트레일러 분리"
msgstr "トレーラー切り離し"

msgid "트레일러 연결"
msgstr "トレーラー連結"

msgid "트레일러를 연결할 때 커플러가 0.6초쯤 '덜커덕덜컥' 맞물리고, 분리할 때 '쿵'에 이어 에어 빠지는 느낌."
msgstr "トレーラー連結時はカプラーが 0.6 秒ほど「ガタガタッ」とかみ合い、切り離し時は「ドン」に続いてエアが抜ける感触。"

msgid "트리거"
msgstr "トリガー"

msgid "트리거 모터에만 적용되는 최종 세기입니다. 0%면 트리거 진동이 완전히 꺼집니다. 손가락이 부담스러우면 여기서 낮추세요. 효과별 비율은 그대로 유지됩니다."
msgstr "トリガーモーターだけにかかる最終的な強さです。0% でトリガーの振動は完全にオフになります。指が疲れるならここで下げてください。エフェクト同士のバランスはそのままです。"

msgid "트리거 채널이 지금 따라가는 페달입니다."
msgstr "トリガーチャンネルがいま追っているペダルです。"

msgid "파킹 브레이크"
msgstr "パーキングブレーキ"

msgid "파킹 브레이크 체결"
msgstr "パーキングブレーキ オン"

msgid "파킹 브레이크 해제"
msgstr "パーキングブレーキ オフ"

msgid "파킹 브레이크를 체결하면 '철컥'에 이어 1초 가까이 에어가 빠지는 '쉬이익', 해제하면 '턱'에 이어 짧은 '푸쉭'."
msgstr "パーキングブレーキをかけると「ガチャン」に続いて 1 秒近くエアが抜ける「シューッ」、外すと「コトン」に続いて短い「プシュッ」。"

msgid "패드 {buttons}"
msgstr "パッド {buttons}"

msgid "페달"
msgstr "ペダル"

msgid "페달 바닥"
msgstr "ペダル踏み切り"

msgid "페리"
msgstr "フェリー"

msgid "포트홀, 연석, 이음매처럼 서스펜션이 갑자기 움직이면 그 바퀴 쪽 그립에 충격을 냅니다. 작은 이음매는 짧고 높은 '톡', 큰 포트홀은 낮고 묵직한 '쿵'이고, 큰 충격 뒤에는 캡이 잠깐 덜컹거립니다. 민감도는 '요철 감지 기준'에서 정합니다. 흙길처럼 캐빈이 출렁이면 그 흔들림을 따라 낮은 '웅'이 이어지고, 캐빈이 기우는 쪽 그립이 더 셉니다."
msgstr "ポットホール、縁石、継ぎ目などでサスペンションが急に動くと、その車輪側のグリップに衝撃を出します。小さな継ぎ目は短く高い「トン」、大きなポットホールは低く重い「ドン」で、大きな衝撃のあとはキャブが少しガタつきます。感度は「段差しきい値」で決めます。未舗装路のようにキャブが揺れると、その揺れに合わせて低い「ウーン」が続き、キャブが傾く側のグリップが強くなります。"

msgid "폴더에 쓸 권한이 없습니다. 프로그램을 관리자 권한으로 실행하거나 아래 파일을 직접 복사하세요."
msgstr "フォルダーへの書き込み権限がありません。管理者として実行するか、下のファイルを直接コピーしてください。"

msgid "프리셋"
msgstr "プリセット"

msgid "프리셋 이름"
msgstr "プリセット名"

msgid "프리셋 전환"
msgstr "プリセットの切り替え"

msgid "프리셋마다 세기, 기준, 켜기/끄기, 진동 위치, 기통 수, 변속기를 통째로 따로 둡니다. 트럭과 트립 모드의 승용차처럼 탈것이 바뀔 때 눌러서 바로 바꿉니다. 주행 중에도 즉시 적용되고 다음 실행에도 이어집니다."
msgstr "プリセットごとに強さ、しきい値、オン/オフ、振動の場所、気筒数、トランスミッションを丸ごと別に持ちます。トラックとトリップモードの乗用車のように乗り物が変わるときに押せばすぐ切り替わります。走行中でもすぐ反映され、次回の起動にも引き継がれます。"

msgid "플러그인"
msgstr "プラグイン"

msgid "플러그인 설치"
msgstr "プラグインのインストール"

msgid "호환되는 텔레메트리 플러그인이 없습니다 → '텔레메트리 플러그인'"
msgstr "互換テレメトリープラグインがありません →「テレメトリープラグイン」"

msgid "회전 각속도 부호 뒤집음 (바퀴 속도 기준)"
msgstr "ヨーレートの符号を反転（車輪速度から）"

msgid "효과 테스트"
msgstr "エフェクトテスト"

msgid "효과 테스트: {name}"
msgstr "エフェクトテスト: {name}"

msgid "휠스핀"
msgstr "ホイールスピン"

msgid "흙"
msgstr "土"

msgid "＋ 지금 설정으로 새 프리셋"
msgstr "＋ 今の設定で新規"
